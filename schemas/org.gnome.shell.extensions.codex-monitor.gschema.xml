<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.codex-monitor" path="/org/gnome/shell/extensions/codex-monitor/">
    <key name="refresh-interval" type="i">
      <default>15</default>
      <range min="5" max="120"/>
      <summary>Intervalo de actualización en minutos</summary>
    </key>
    <key name="display-mode" type="s">
      <default>'remaining'</default>
      <choices>
        <choice value="remaining"/>
        <choice value="used"/>
      </choices>
      <summary>Porcentaje mostrado</summary>
    </key>
  </schema>
</schemalist>
